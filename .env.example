# ============================================================
# ACLC LabPulse - Environment Variables Template
# Institution: ACLC College of Manila (College of Computer Studies / IT Dept)
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE & ORM (PostgreSQL - Neon / Supabase)
# ------------------------------------------------------------
# Direct connection for Prisma Client & migrations
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/aclc_labpulse?sslmode=require"
# Direct URL used for migrations when using transaction poolers like PgBouncer
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/aclc_labpulse?sslmode=require"

# ------------------------------------------------------------
# 2. NEXT.JS APP & AUTHENTICATION
# ------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-random-32-byte-hex-key"
NEXT_PUBLIC_APP_NAME="ACLC LabPulse"
NEXT_PUBLIC_INSTITUTION="ACLC College of Manila"
NEXT_PUBLIC_DEPARTMENT="College of Computer Studies / IT Department"
NEXT_PUBLIC_CAMPUS_CODE="MNL-MAIN"

# Supabase Auth / Storage (Optional if using Supabase client directly)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------
# 3. NOTIFICATION & WEBHOOK INTEGRATIONS
# ------------------------------------------------------------
# Discord Webhook for IT Tech & Custodian Emergency Alerts
DISCORD_MAINTENANCE_WEBHOOK_URL="https://discord.com/api/webhooks/123456789/abcdefghijklmnopqrstuvwxyz"
DISCORD_SECURITY_WEBHOOK_URL="https://discord.com/api/webhooks/123456789/abcdefghijklmnopqrstuvwxyz"

# Telegram Bot API for SMS-style instantaneous alerts
TELEGRAM_BOT_TOKEN="123456789:ABCDEF-xyz_example_token_for_labpulse"
TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------
# 4. HARDWARE DISCOVERY AGENT (PowerShell Client Security)
# ------------------------------------------------------------
# Shared bearer token validated by /api/discovery/heartbeat endpoint
DISCOVERY_AGENT_API_SECRET="aclc-sec-audit-token-9b37a1e0c4"

# ------------------------------------------------------------
# 5. INSTITUTIONAL SMTP & CLEARANCE MAILING (Optional)
# ------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="lab.admin@aclc-manila.edu.ph"
SMTP_PASS="app-specific-password-here"
SMTP_FROM="ACLC LabPulse System <noreply@aclc-manila.edu.ph>"

# ------------------------------------------------------------
# 6. AI STUDIO / HOSTING RUNTIME (Injected automatically)
# ------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
